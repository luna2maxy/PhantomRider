#!/usr/bin/env bash
#
#  phantomriderd The PhantomRider Core server.
#
#
# chkconfig: 345 80 20
# description: phantomriderd
# processname: phantomriderd
#

# Source function library.
. /etc/init.d/functions

# you can override defaults in /etc/sysconfig/phantomriderd, see below
if [ -f /etc/sysconfig/phantomriderd ]; then
        . /etc/sysconfig/phantomriderd
fi

RETVAL=0

prog=phantomriderd
# you can override the lockfile via BITCOIND_LOCKFILE in /etc/sysconfig/phantomriderd
lockfile=${BITCOIND_LOCKFILE-/var/lock/subsys/phantomriderd}

# phantomriderd defaults to /usr/bin/phantomriderd, override with BITCOIND_BIN
phantomriderd=${BITCOIND_BIN-/usr/bin/phantomriderd}

# phantomriderd opts default to -disablewallet, override with BITCOIND_OPTS
phantomriderd_opts=${BITCOIND_OPTS--disablewallet}

start() {
    echo -n $"Starting $prog: "
    daemon $DAEMONOPTS $phantomriderd $phantomriderd_opts
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && touch $lockfile
    return $RETVAL
}

stop() {
    echo -n $"Stopping $prog: "
    killproc $prog -t600
    RETVAL=$?
    echo
    [ $RETVAL -eq 0 ] && rm -f $lockfile
    return $RETVAL
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    status)
        status $prog
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: service $prog {start|stop|status|restart}"
        exit 1
        ;;
esac
